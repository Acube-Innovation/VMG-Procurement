  },
  {
   "fieldname": "gm_approved_by",
   "fieldtype": "Link",
   "label": "GM Approved By",
   "no_copy": 1,
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "gm_approved_on",
   "fieldtype": "Datetime",
   "label": "GM Approved On",
   "no_copy": 1,
   "read_only": 1
  },
  {

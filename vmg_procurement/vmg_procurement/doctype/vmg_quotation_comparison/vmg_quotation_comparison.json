 "fields": [
  {
   "fieldname": "details_section",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "default": "Today",
   "fieldname": "transaction_date",
   "fieldtype": "Date",
   "in_standard_filter": 1,
   "label": "Transaction Date"
  },
  {
   "fieldname": "request_for_quotation",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Request for Quotation",
   "options": "VMG Request for Quotation",
   "reqd": 1
  },
  {
   "fetch_from": "request_for_quotation.purchase_requisition",
   "fieldname": "purchase_requisition",
   "fieldtype": "Link",
   "label": "Purchase Requisition",
   "options": "VMG Purchase Requisition",
   "read_only": 1
  },
  {
   "fetch_from": "request_for_quotation.division",
   "fieldname": "division",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Division",
   "options": "VMG Division",
   "read_only": 1
  },
  {
   "fieldname": "column_break_details",
   "fieldtype": "Column Break"
  },
  {
   "fetch_from": "request_for_quotation.project",
   "fieldname": "project",
   "fieldtype": "Link",
   "label": "Project",
   "options": "Project",
   "read_only": 1
  },
  {
   "fetch_from": "request_for_quotation.cost_center",
   "fieldname": "cost_center",
   "fieldtype": "Link",
   "label": "Cost Center",
   "options": "Cost Center",
   "read_only": 1
  },
  {
   "default": "__user",
   "fieldname": "prepared_by",
   "fieldtype": "Link",
   "label": "Prepared By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "suppliers_section",
   "fieldtype": "Section Break",
   "label": "Suppliers"
  },
  {
   "fieldname": "suppliers",
   "fieldtype": "Table",
   "label": "Suppliers",
   "options": "VMG Comparison Supplier",
   "reqd": 1
  },
  {
   "fieldname": "item_comparison_section",
   "fieldtype": "Section Break",
   "label": "Item Comparison"
  },
  {
   "description": "Generated by Get Quotations: rates per supplier column, side by side",
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "VMG Comparison Item"
  },
  {
   "fieldname": "selection_section",
   "fieldtype": "Section Break",
   "label": "Selection"
  },
  {
   "default": "Single Supplier",
   "description": "Split by Item awards each line to a supplier column and creates one LPO per awarded supplier",
   "fieldname": "award_mode",
   "fieldtype": "Select",
   "label": "Award Mode",
   "options": "Single Supplier\nSplit by Item"
  },
  {
   "fieldname": "selected_supplier",
   "fieldtype": "Link",
   "label": "Selected Supplier",
   "options": "Supplier",
   "depends_on": "eval:doc.award_mode !== 'Split by Item'"
  },
  {
   "fieldname": "selected_quotation",
   "fieldtype": "Link",
   "label": "Selected Quotation",
   "options": "VMG Supplier Quotation",
   "depends_on": "eval:doc.award_mode !== 'Split by Item'"
  },
  {
   "fieldname": "selection_basis",
   "fieldtype": "Select",
   "label": "Selection Basis",
   "mandatory_depends_on": "eval:doc.selected_quotation",
   "options": "\nLowest Price\nProduct Quality\nDelivery Time\nLegal Compliance\nPayment Terms\nSole Source"
  },
  {
   "fieldname": "column_break_selection",
   "fieldtype": "Column Break"
  },
  {
   "fetch_from": "selected_quotation.grand_total",
   "fieldname": "awarded_value",
   "fieldtype": "Currency",
   "label": "Awarded Value (AED)",
   "read_only": 1
  },
  {
   "default": "0",
   "fieldname": "is_lowest_price",
   "fieldtype": "Check",
   "label": "Is Lowest Price",
   "read_only": 1
  },
  {
   "description": "Mandatory when the selection is not the lowest price or the supplier is not approved",
   "fieldname": "justification",
   "fieldtype": "Small Text",
   "label": "Justification",
   "mandatory_depends_on": "eval:doc.selected_quotation && !doc.is_lowest_price"
  },
  {
   "fieldname": "recommendation_remarks",
   "fieldtype": "Small Text",
   "label": "Recommendation Remarks"
  },
  {
   "collapsible": 1,
   "fieldname": "approval_log_section",
   "fieldtype": "Section Break",
   "label": "Approval Log"
  },
  {
   "fieldname": "division_approved_by",
   "fieldtype": "Link",
   "label": "Division Approved By",
   "no_copy": 1,
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "division_approved_on",
   "fieldtype": "Datetime",
   "label": "Division Approved On",
   "no_copy": 1,
   "read_only": 1
  },
  {
   "fieldname": "cfo_approved_by",

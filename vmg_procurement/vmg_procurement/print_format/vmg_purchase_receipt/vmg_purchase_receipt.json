 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n\tbody {\n\t\tmin-height: 0 !important;\n\t\tmargin: 0 auto !important;\n\t}\n\t.vmg-grn { font-size: 9pt; }\n\t.vmg-grn h2 { text-align: center; margin: 0; letter-spacing: 2px; font-size: 13pt; }\n\t.vmg-grn .sub { text-align: center; font-size: 8pt; color: #555; margin-bottom: 8px; }\n\t.vmg-grn table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }\n\t.vmg-grn th, .vmg-grn td { border: 1px solid #444; padding: 3px 5px; vertical-align: top; }\n\t.vmg-grn .meta td { border: none; padding: 1px 4px; }\n\t.vmg-grn .meta .label { color: #555; white-space: nowrap; width: 20%; }\n\t.vmg-grn thead { display: table-header-group; }\n\t.vmg-grn th { background: #eee; }\n\t.vmg-grn .num { text-align: right; white-space: nowrap; }\n\t.vmg-grn .desc { white-space: pre-line; }\n\t.vmg-grn .reject { color: #b00; font-weight: bold; }\n\t.vmg-grn .note { border: 1px solid #444; padding: 4px 6px; margin-bottom: 8px; font-size: 8.5pt; }\n\t.vmg-grn .sig { page-break-inside: avoid; margin-bottom: 0; }\n\t.vmg-grn .sig td { border: 1px solid #444; text-align: center; font-size: 8pt; height: 48px; vertical-align: bottom; padding-bottom: 3px; }\n\t.vmg-grn .sig .who { font-weight: bold; }\n</style>\n\n<div class=\"vmg-grn\">\n\t<h2>GOODS RECEIPT NOTE</h2>\n\t<div class=\"sub\">{{ doc.name }} &mdash; delivery note acceptance</div>\n\n\t<table class=\"meta\">\n\t\t<tr>\n\t\t\t<td class=\"label\">Receipt No</td>\n\t\t\t<td><b>{{ doc.name }}</b></td>\n\t\t\t<td class=\"label\">Receipt Date</td>\n\t\t\t<td>{{ frappe.utils.formatdate(doc.receipt_date) }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"label\">Supplier</td>\n\t\t\t<td>{{ frappe.db.get_value(\"Supplier\", doc.supplier, \"supplier_name\") or doc.supplier }}</td>\n\t\t\t<td class=\"label\">Local Purchase Order</td>\n\t\t\t<td>{{ doc.local_purchase_order or \"-\" }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"label\">Supplier Delivery Note</td>\n\t\t\t<td>{{ doc.supplier_delivery_note_no }}{% if doc.supplier_delivery_note_date %} dated {{ frappe.utils.formatdate(doc.supplier_delivery_note_date) }}{% endif %}</td>\n\t\t\t<td class=\"label\">Requisition</td>\n\t\t\t<td>{{ doc.purchase_requisition or \"-\" }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"label\">Division / Site</td>\n\t\t\t<td>{{ doc.division }}{% if doc.received_at_site %} &mdash; {{ doc.received_at_site }}{% endif %}</td>\n\t\t\t<td class=\"label\">Acceptance</td>\n\t\t\t<td><b>{{ doc.acceptance_status }}</b>{% if doc.is_partial %} (partial delivery){% endif %}</td>\n\t\t</tr>\n\t</table>\n\n\t<table class=\"items\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th style=\"width: 4%\">#</th>\n\t\t\t\t<th>Description</th>\n\t\t\t\t<th style=\"width: 8%\">Unit</th>\n\t\t\t\t<th style=\"width: 9%\" class=\"num\">Ordered</th>\n\t\t\t\t<th style=\"width: 9%\" class=\"num\">Received</th>\n\t\t\t\t<th style=\"width: 9%\" class=\"num\">Accepted</th>\n\t\t\t\t<th style=\"width: 9%\" class=\"num\">Rejected</th>\n\t\t\t\t<th style=\"width: 16%\">Remarks</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{% for row in doc.items %}\n\t\t\t<tr>\n\t\t\t\t<td class=\"num\">{{ row.idx }}</td>\n\t\t\t\t<td class=\"desc\">{{ row.description }}</td>\n\t\t\t\t<td>{{ row.uom or \"\" }}</td>\n\t\t\t\t<td class=\"num\">{{ row.ordered_qty if row.ordered_qty else \"-\" }}</td>\n\t\t\t\t<td class=\"num\">{{ row.received_qty }}</td>\n\t\t\t\t<td class=\"num\">{{ row.accepted_qty }}</td>\n\t\t\t\t<td class=\"num {{ 'reject' if row.rejected_qty else '' }}\">{{ row.rejected_qty or 0 }}</td>\n\t\t\t\t<td class=\"desc\">{{ row.remarks or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t{% endfor %}\n\t\t</tbody>\n\t</table>\n\n\t{% if doc.rejection_reason %}\n\t<div class=\"note\"><b>Rejection Reason:</b> {{ doc.rejection_reason }}</div>\n\t{% endif %}\n\t{% if doc.inspection_remarks %}\n\t<div class=\"note\"><b>Inspection Remarks:</b> {{ doc.inspection_remarks }}</div>\n\t{% endif %}\n\n\t<table class=\"sig\">\n\t\t<tr>\n\t\t\t<td style=\"width: 33%\"><span class=\"who\">Received By</span><br>{{ frappe.db.get_value(\"Employee\", doc.received_by, \"employee_name\") or \"\" if doc.received_by else \"&nbsp;\" }}<br>Signature / Date</td>\n\t\t\t<td style=\"width: 33%\"><span class=\"who\">Inspected By</span><br>{{ frappe.db.get_value(\"Employee\", doc.inspected_by, \"employee_name\") or \"\" if doc.inspected_by else \"&nbsp;\" }}<br>Signature / Date</td>\n\t\t\t<td style=\"width: 34%\"><span class=\"who\">Procurement</span><br>&nbsp;<br>Signature / Date</td>\n\t\t</tr>\n\t</table>\n</div>\n",
 "idx": 0,
